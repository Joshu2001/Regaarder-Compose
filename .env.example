VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Paddle Configuration
# Get your client-side token from Paddle Dashboard -> Developer Tools -> Authentication
VITE_PADDLE_CLIENT_TOKEN=test_your_client_token_here
# Must be 'sandbox' or 'production'
VITE_PADDLE_ENV=sandbox

# Paddle Price IDs (Create via Paddle dashboard or seed script)
VITE_PADDLE_PRICE_STARTER_MONTH=pri_starter_month
VITE_PADDLE_PRICE_STARTER_YEAR=pri_starter_year
VITE_PADDLE_PRICE_PRO_MONTH=pri_pro_month
VITE_PADDLE_PRICE_PRO_YEAR=pri_pro_year
VITE_PADDLE_PRICE_ADVANCED_MONTH=pri_advanced_month
VITE_PADDLE_PRICE_ADVANCED_YEAR=pri_advanced_year
